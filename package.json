{
  "name": "tripdock",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @tripdock/api --filter @tripdock/web dev",
    "build": "pnpm -r --filter @tripdock/api --filter @tripdock/web build",
    "start": "pnpm --parallel --filter @tripdock/api --filter @tripdock/web start",
    "lint": "pnpm -r --filter @tripdock/api --filter @tripdock/web lint",
    "typecheck": "pnpm -r --filter @tripdock/api --filter @tripdock/web typecheck",
    "test": "pnpm -r --filter @tripdock/api --filter @tripdock/web test",
    "test:postgres": "pnpm --filter @tripdock/api test:postgres",
    "test:ai-live": "pnpm --filter @tripdock/api test:ai-live",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @tripdock/api db:generate",
    "db:migrate": "pnpm --filter @tripdock/api db:migrate",
    "db:reset": "pnpm --filter @tripdock/api db:reset",
    "check": "pnpm test && pnpm lint && pnpm typecheck && pnpm build"
  }
}
