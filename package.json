{
  "name": "tripdock",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "dev": "pnpm --filter @tripdock/web dev",
    "build": "pnpm --filter @tripdock/web build",
    "start": "pnpm --filter @tripdock/web start",
    "lint": "pnpm --filter @tripdock/web lint",
    "typecheck": "pnpm --filter @tripdock/web typecheck",
    "test": "pnpm --filter @tripdock/web test",
    "check": "pnpm test && pnpm lint && pnpm typecheck && pnpm build"
  }
}
