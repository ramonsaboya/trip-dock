# Replace __HOSTNAME__ with the confirmed hostname after obtaining its certificate.
server {
    listen 80;
    server_name __HOSTNAME__;
    location ^~ /.well-known/acme-challenge/ { root /var/www/tripdock-acme; }
    location / { return 308 https://__HOSTNAME__$request_uri; }
}
server {
    listen 443 ssl;
    server_name __HOSTNAME__;
    ssl_certificate /etc/letsencrypt/live/tripdock/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tripdock/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 1m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_connect_timeout 5s;
    proxy_read_timeout 120s;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    location = /graphql {
        add_header Cache-Control "no-store" always;
        proxy_pass http://127.0.0.1:4040;
    }
    location = /voice/session {
        add_header Cache-Control "no-store" always;
        proxy_pass http://127.0.0.1:4040;
    }
    location / { proxy_pass http://127.0.0.1:3040; }
}
