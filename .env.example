# PostgreSQL is the canonical store. The Docker Compose default is local only.
DATABASE_URL=postgresql://tripdock:tripdock@127.0.0.1:5432/tripdock
TEST_DATABASE_URL=postgresql://tripdock:tripdock@127.0.0.1:5432/tripdock_test
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql

# Server-only. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=
