{
  "name": "@tripdock/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint . --ignore-pattern dist",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:postgres": "tsx tests/run-postgres-test.ts",
    "test:ai-live": "tsx src/scripts/live-ai-smoke.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:reset": "tsx src/scripts/reset-db.ts"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "graphql": "17.0.2",
    "graphql-yoga": "5.22.0",
    "openai": "7.8.0",
    "pg": "8.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@typescript-eslint/parser": "8.68.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "pg-mem": "3.0.14",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
